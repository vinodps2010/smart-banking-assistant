2026-08-19 17:04:07,414 | INFO  | SBA  | generate_sql         | SQL generation completed :WITH latest_balances AS (
    SELECT
        account_id,
        txn_date,
        balance_after,
        ROW_NUMBER() OVER (
            PARTITION BY account_id
            ORDER BY txn_date DESC, created_at DESC
        ) AS rn
    FROM transactions
)
SELECT
    a.account_id,
    a.customer_name,
    a.account_type,
    a.branch_code,
    a.ifsc_code,
    lb.balance_after AS current_balance,
    lb.txn_date AS balance_as_of_date
FROM accounts a
JOIN latest_balances lb
    ON a.account_id = lb.account_id
WHERE lb.rn = 1
  AND lb.balance_after > 100000
ORDER BY lb.balance_after DESC
LIMIT 100;
