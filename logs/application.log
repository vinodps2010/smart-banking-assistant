2026-08-21 05:51:00,364 | INFO  | SBA  | generate_sql         | SQL generation completed :SELECT
    a.account_id,
    a.customer_name,
    a.kyc_status,
    (
        SELECT COUNT(*)
        FROM credit_cards cc
        WHERE cc.account_id = a.account_id
    ) AS credit_card_count,
    (
        SELECT STRING_AGG(DISTINCT cc.status, ', ')
        FROM credit_cards cc
        WHERE cc.account_id = a.account_id
    ) AS credit_card_statuses,
    (
        SELECT COALESCE(SUM(cc.outstanding_amt), 0)
        FROM credit_cards cc
        WHERE cc.account_id = a.account_id
    ) AS total_credit_card_outstanding,
    (
        SELECT COUNT(*)
        FROM loan_accounts la
        WHERE la.account_id = a.account_id
    ) AS loan_count,
    (
        SELECT STRING_AGG(DISTINCT la.status, ', ')
        FROM loan_accounts la
        WHERE la.account_id = a.account_id
    ) AS loan_statuses,
    (
        SELECT COALESCE(SUM(la.outstanding), 0)
        FROM loan_accounts la
        WHERE la.account_id = a.account_id
    ) AS total_loan_outstanding
FROM accounts a
WHERE a.account_id = '1345367'
LIMIT 100;
